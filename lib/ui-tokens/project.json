{
  "name": "ui-tokens",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "ui-tokens/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": [
        "dist/{projectRoot}"
      ],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [
    "scope:tokens"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/ui-tokens",
        "main": "ui-tokens/src/index.ts",
        "tsConfig": "ui-tokens/tsconfig.lib.json",
        "assets": [
          "ui-tokens/*.md"
        ]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
