{
  "_comment": "Scripted model answers for the phase 5 scenario (infra/e2e/agents/fixture_model.py). sql-refuse-delete is deliberately unsafe: the agent must reject it and answer kind none.",
  "rules": [
    {
      "id": "sql-revenue-by-customer",
      "operation": "sql",
      "contains": [
        "revenue by customer"
      ],
      "output": {
        "kind": "query",
        "sql": "SELECT c.Name AS Customer, c.Country AS Country, SUM(l.Quantity * l.UnitPrice) AS Revenue\nFROM dbo.Customers AS c\nJOIN dbo.Orders AS o ON o.CustomerId = c.CustomerId\nJOIN dbo.OrderLines AS l ON l.OrderId = o.OrderId\nGROUP BY c.Name, c.Country\nORDER BY Revenue DESC",
        "explanation": "Revenue is quantity times unit price per order line, summed per customer through Orders."
      }
    },
    {
      "id": "sql-total-revenue",
      "operation": "sql",
      "contains": [
        "total revenue"
      ],
      "output": {
        "kind": "query",
        "sql": "SELECT SUM(l.Quantity * l.UnitPrice) AS TotalRevenue\nFROM dbo.OrderLines AS l",
        "explanation": "Total revenue is quantity times unit price summed over all order lines."
      }
    },
    {
      "id": "sql-refuse-delete",
      "operation": "sql",
      "contains": [
        "delete"
      ],
      "output": {
        "kind": "query",
        "sql": "DELETE FROM dbo.Customers",
        "explanation": "Deletes customers."
      }
    },
