{
  "name": "esi-portal",
  "version": "0.0.0",
  "private": true,
  "description": "ESI management portal (Angular). Hosts independent feature modules such as the AI assistant.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "esi": {
    "coreApiContract": "0.3.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "check": "npm run lint && npm run test:boundaries && npm test && npm run build",
    "test:boundaries": "node scripts/test-boundaries.mjs",
    "generate:api": "node scripts/generate-api.mjs"
  },
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@auth0/auth0-angular": "2.13.0",
    "@dtnam0899/dsl-core": "0.2.0",
    "@dtnam0899/dsl-renderer-angular": "0.2.0",
    "@dtnam0899/dsl-schema": "0.2.0",
    "@primeuix/themes": "2.0.3",
    "primeng": "21.1.10",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.27",
    "@angular/cli": "21.2.27",
    "@angular/compiler-cli": "21.2.25",
    "@eslint/js": "9.39.5",
    "@hey-api/openapi-ts": "0.99.0",
    "angular-eslint": "21.4.0",
    "eslint": "9.39.5",
    "jsdom": "29.1.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.0.18"
  }
}
