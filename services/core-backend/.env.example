# Copy to .env (git-ignored) to override local settings; docker compose reads .env automatically.
# Password of the `esi` user of the local Postgres app database (esi_core). Changing it after the first start needs
# `docker compose down -v` (the password is stored in the data volume).
ESI_CORE_PG_PASSWORD=EsiLocalDev_2026
# sa password for the local SQL Server container (holds only esi_target for integration tests): at least 8 characters from 3 of upper, lower, digit, symbol.
# Changing it after the first start needs `docker compose down -v` (the password is stored in the data volume).
ESI_CORE_SA_PASSWORD=EsiLocalDev_2026
# SQL Server memory cap in MB (SQL Server needs at least 2000 MB of Docker VM memory).
ESI_CORE_SQL_MEMORY_LIMIT_MB=2048
# API log level: Trace, Debug, Information, Warning, Error.
ESI_CORE_LOG_LEVEL=Information
# Master key for connection-string encryption, base64 of 32 random bytes (ADR-0003). Local only; generate one with
# `openssl rand -base64 32`. Changing it makes stored connections unreadable (re-enter them or reset the volume).
ESI_CORE_MASTER_KEY_V1=bG9jYWwtZGV2LW9ubHkta2V5LW5vdC1hLXNlY3JldCE=
# Base URL of services/ai-agents (run from its own directory). host.docker.internal reaches the host from the api container.
ESI_CORE_AGENTS_URL=http://host.docker.internal:8000/
