{
    "description": "Row values that look like HTML, Markdown or bindings are shown as plain text.",
    "artifact": {
        "dslSchemaVersion": 1,
        "protocolVersion": "v0.9",
        "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json",
        "columns": [
